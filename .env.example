# ---------------------------------------------------------------------------
# Application environment variables (copy to .env, never commit real values)
# ---------------------------------------------------------------------------

# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://approval_user:approval_pass@localhost:5434/approval_db?schema=public"

# Authentication secret (>= 32 characters). Generate a unique value per environment.
JWT_SECRET="development_jwt_secret_change_in_production_min32chars"

# Session lifetime in seconds (default 8 hours)
JWT_EXPIRES_IN_SECONDS="28800"

# Server configuration
PORT=3000
NODE_ENV="development"
CLIENT_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"

# Commit shown by GET /api/health. CI/CD sets this automatically.
GIT_COMMIT="local"

# ---------------------------------------------------------------------------
# Optional Docker Compose overrides (not read by the application)
# ---------------------------------------------------------------------------
# POSTGRES_USER=approval_user
# POSTGRES_PASSWORD=approval_pass
# POSTGRES_DB=approval_db
# POSTGRES_PORT=5434
# APP_PORT=3000
